{
  "name": "@caide/engine",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "caide-engine": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
