{
  "name": "@synara/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "synara-engine": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "import": "./src/protocol.ts"
    }
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@synara/contracts": "workspace:*",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.19 || ^23.11 || >=24.10"
  }
}
