    "@remotion/shapes": "4.0.524",
    "@remotion/tailwind-v4": "4.0.524",
    "@remotion/transitions": "4.0.524",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.524",
    "tailwindcss": "4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "catalog:"
  }
