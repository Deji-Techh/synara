{
  "name": "@caide/video",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts CaideLaunch out/caide-launch.mp4",
