    "still": "remotion still src/index.ts CaideLaunch out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "@remotion/google-fonts": "4.0.524",
    "@remotion/media": "4.0.524",
