---
// FILE: download.astro
// Purpose: Caide download page (monochrome) — platform picker. Build links are
//          placeholders until final release URLs are available.
// Layer: Marketing page
// Depends on: Layout, PlatformIcon.
import PlatformIcon from "../components/PlatformIcon.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Download — Caide"
  description="Download Caide for macOS, Windows, or Linux."
>
  <header class="page-head" data-reveal>
    <p class="page-index">/ Download</p>
    <h1 class="page-title">Get Caide.</h1>
    <p class="page-sub">
      Demo builds for macOS, Windows, and Linux. Final download links land here
      soon.
    </p>
  </header>

  <div class="platforms" id="platforms">
    <!-- macOS -->
    <section class="platform" data-reveal>
      <div class="platform-head">
        <PlatformIcon platform="apple" class="platform-icon" />
        <h2 class="platform-name">macOS</h2>
      </div>
      <div class="cards">
        <a class="card" href="#">
          <span class="card-label">Apple Silicon</span>
          <span class="card-meta">arm64 &middot; .dmg</span>
          <span class="card-arrow" aria-hidden="true">&#8595;</span>
        </a>
        <a class="card" href="#">
          <span class="card-label">Intel</span>
          <span class="card-meta">x64 &middot; .dmg</span>
          <span class="card-arrow" aria-hidden="true">&#8595;</span>
        </a>
      </div>
    </section>

    <!-- Windows -->
    <section class="platform" data-reveal>
      <div class="platform-head">
        <PlatformIcon platform="windows" class="platform-icon" />
        <h2 class="platform-name">Windows</h2>
      </div>
      <div class="cards">
        <a class="card" href="#">
          <span class="card-label">Windows 10 &amp; 11</span>
          <span class="card-meta">x64 &middot; .exe</span>
          <span class="card-arrow" aria-hidden="true">&#8595;</span>
        </a>
      </div>
    </section>

    <!-- Linux -->
    <section class="platform" data-reveal>
      <div class="platform-head">
        <PlatformIcon platform="linux" class="platform-icon" />
        <h2 class="platform-name">Linux</h2>
      </div>
      <div class="cards">
        <a class="card" href="#">
          <span class="card-label">Linux</span>
          <span class="card-meta">x64 &middot; AppImage</span>
          <span class="card-arrow" aria-hidden="true">&#8595;</span>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* `<main>` is rendered by the shared Layout, so un-scope to match. */
  :global(.main) {
    max-width: 900px;
    align-self: center;
    padding: clamp(3.5rem, 8vh, 6rem) clamp(1.5rem, 5vw, 2.5rem)
      clamp(4rem, 8vw, 6.5rem);
  }

  .page-head {
    margin-bottom: clamp(2.75rem, 5vw, 4rem);
  }

  .page-index {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 1.2rem;
  }

  .page-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.2rem;
  }

  .page-sub {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--fg-soft);
    max-width: 46ch;
    line-height: 1.8;
  }

  /* ── Platforms ── */

  .platforms {
    display: flex;
    flex-direction: column;
    gap: 3.25rem;
  }

  .platform-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: 1.2rem;
  }

  .platform-icon {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--fg);
  }

  .platform-name {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-soft);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    padding: 1.6rem 1.55rem;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .card:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
  }

  .card-label {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .card-meta {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.03em;
    color: var(--fg-faint);
    line-height: 1.6;
  }

  .card-arrow {
    margin-top: 0.55rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
