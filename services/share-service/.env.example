PORT=8787
DATABASE_URL=postgres://caide:caide@localhost:5432/caide_share
SHARE_PUBLIC_BASE_URL=http://localhost:8787
CAIDE_DOWNLOAD_WINDOWS=https://github.com/Deji-Techh/caide/releases/latest
CAIDE_DOWNLOAD_LINUX=https://github.com/Deji-Techh/caide/releases/latest
CAIDE_DOWNLOAD_MACOS=https://github.com/Deji-Techh/caide/releases/latest
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=caide-shares
S3_ACCESS_KEY_ID=caide
S3_SECRET_ACCESS_KEY=caide-local-secret
S3_FORCE_PATH_STYLE=true
MAX_PACKAGE_BYTES=524288000
API_RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY=false

# Resend email (for magic link auth)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=CAIDE <auth@fundtracer.xyz>
APP_DEEP_LINK_SCHEME=neonquokkaslide
