{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "CAIDE_HOME",
    "CAIDE_DESKTOP_WS_URL",
    "CAIDE_BROWSER_HOST_PIPE_PATH",
    "CAIDE_BROWSER_USE_PIPE_PATH",
    "CAIDE_BROWSER_PERF",
    "CAIDE_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "CAIDE_GROK_ACP_DEBUG",
    "CAIDE_WEB_SOURCEMAP",
    "CAIDE_SERVER_SOURCEMAP",
    "CAIDE_DESKTOP_SOURCEMAP",
    "CAIDE_MODE",
    "CAIDE_PORT",
    "CAIDE_NO_BROWSER",
    "CAIDE_AUTH_TOKEN",
    "CAIDE_PUBLIC_URL",
    "CAIDE_ALLOW_INSECURE_REMOTE",
    "CAIDE_LOG_WS_EVENTS",
    "CAIDE_HOST",
    "CAIDE_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
